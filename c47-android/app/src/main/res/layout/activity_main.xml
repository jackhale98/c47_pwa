<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a"
    android:padding="8dp">

    <!-- Display Section -->
    <LinearLayout
        android:id="@+id/display_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#000000"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Main Display -->
        <TextView
            android:id="@+id/display"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="0"
            android:textSize="36sp"
            android:textColor="#00ff00"
            android:fontFamily="monospace"
            android:gravity="end|center_vertical"
            android:background="#0a0a0a"
            android:padding="8dp" />

        <!-- Stack Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/stack_t"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="T: 0"
                android:textSize="10sp"
                android:textColor="#00ff00"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/stack_z"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Z: 0"
                android:textSize="10sp"
                android:textColor="#00ff00"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/stack_y"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Y: 0"
                android:textSize="10sp"
                android:textColor="#00ff00"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/stack_x"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="X: 0"
                android:textSize="10sp"
                android:textColor="#00ff00"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Status Indicators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/angle_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEG"
                android:textSize="10sp"
                android:textColor="#ffff00"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/shift_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#ff00ff"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/alpha_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#00ffff"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- Button Grid -->
    <GridLayout
        android:id="@+id/button_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:columnCount="5"
        android:rowCount="8"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/display_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Function Keys -->
        <Button android:id="@+id/btn_shift" style="@style/FunctionButton" android:text="SHIFT" />
        <Button android:id="@+id/btn_alpha" style="@style/FunctionButton" android:text="ALPHA" />
        <Button android:id="@+id/btn_mode" style="@style/FunctionButton" android:text="MODE" />
        <Button android:id="@+id/btn_sto" style="@style/FunctionButton" android:text="STO" />
        <Button android:id="@+id/btn_rcl" style="@style/FunctionButton" android:text="RCL" />

        <!-- Row 2: Trig Functions -->
        <Button android:id="@+id/btn_sin" style="@style/ScientificButton" android:text="SIN" />
        <Button android:id="@+id/btn_cos" style="@style/ScientificButton" android:text="COS" />
        <Button android:id="@+id/btn_tan" style="@style/ScientificButton" android:text="TAN" />
        <Button android:id="@+id/btn_asin" style="@style/ScientificButton" android:text="ASIN" />
        <Button android:id="@+id/btn_acos" style="@style/ScientificButton" android:text="ACOS" />

        <!-- Row 3: Log Functions -->
        <Button android:id="@+id/btn_ln" style="@style/ScientificButton" android:text="LN" />
        <Button android:id="@+id/btn_log" style="@style/ScientificButton" android:text="LOG" />
        <Button android:id="@+id/btn_exp" style="@style/ScientificButton" android:text="e^x" />
        <Button android:id="@+id/btn_power" style="@style/ScientificButton" android:text="y^x" />
        <Button android:id="@+id/btn_sqrt" style="@style/ScientificButton" android:text="√x" />

        <!-- Row 4: Stack Operations -->
        <Button android:id="@+id/btn_enter" style="@style/EnterButton" android:text="ENTER" android:layout_columnSpan="2" />
        <Button android:id="@+id/btn_swap" style="@style/StackButton" android:text="x↔y" />
        <Button android:id="@+id/btn_roll" style="@style/StackButton" android:text="R↓" />
        <Button android:id="@+id/btn_clear" style="@style/ClearButton" android:text="CLR" />

        <!-- Row 5: Numbers 7-9 + Operations -->
        <Button android:id="@+id/btn_7" style="@style/NumberButton" android:text="7" />
        <Button android:id="@+id/btn_8" style="@style/NumberButton" android:text="8" />
        <Button android:id="@+id/btn_9" style="@style/NumberButton" android:text="9" />
        <Button android:id="@+id/btn_divide" style="@style/OperationButton" android:text="÷" />
        <Button android:id="@+id/btn_reciprocal" style="@style/OperationButton" android:text="1/x" />

        <!-- Row 6: Numbers 4-6 + Operations -->
        <Button android:id="@+id/btn_4" style="@style/NumberButton" android:text="4" />
        <Button android:id="@+id/btn_5" style="@style/NumberButton" android:text="5" />
        <Button android:id="@+id/btn_6" style="@style/NumberButton" android:text="6" />
        <Button android:id="@+id/btn_multiply" style="@style/OperationButton" android:text="×" />
        <Button android:id="@+id/btn_squared" style="@style/OperationButton" android:text="x²" />

        <!-- Row 7: Numbers 1-3 + Operations -->
        <Button android:id="@+id/btn_1" style="@style/NumberButton" android:text="1" />
        <Button android:id="@+id/btn_2" style="@style/NumberButton" android:text="2" />
        <Button android:id="@+id/btn_3" style="@style/NumberButton" android:text="3" />
        <Button android:id="@+id/btn_minus" style="@style/OperationButton" android:text="−" />
        <Button android:id="@+id/btn_pi" style="@style/ConstantButton" android:text="π" />

        <!-- Row 8: 0, dot, special + Operations -->
        <Button android:id="@+id/btn_0" style="@style/NumberButton" android:text="0" />
        <Button android:id="@+id/btn_dot" style="@style/NumberButton" android:text="." />
        <Button android:id="@+id/btn_chs" style="@style/SpecialButton" android:text="+/-" />
        <Button android:id="@+id/btn_plus" style="@style/OperationButton" android:text="+" />
        <Button android:id="@+id/btn_eex" style="@style/SpecialButton" android:text="EEX" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>